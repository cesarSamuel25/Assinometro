<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ListagemActivity">

    <View
        android:id="@+id/view_topBar_list"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/blue"
        android:elevation="4dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewTitleList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meus Serviços"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@id/view_topBar_list"
        app:layout_constraintEnd_toEndOf="@id/view_topBar_list"
        app:layout_constraintStart_toStartOf="@id/view_topBar_list"
        app:layout_constraintTop_toTopOf="@id/view_topBar_list" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFiltros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Filtros"
        android:textColor="@color/white"
        android:elevation="4dp" app:backgroundTint="@color/blue"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_topBar_list" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewServicos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" android:paddingTop="8dp"
        android:paddingBottom="8dp" android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/btnFiltros"
        app:layout_constraintBottom_toTopOf="@id/btnListagemHistorico" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_servico" />

    <View
        android:id="@+id/view_bottomBar_list"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ic_statistics_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_statistics"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_list"
        app:layout_constraintEnd_toStartOf="@id/ic_home_list"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/view_bottomBar_list"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_list" />

    <ImageView
        android:id="@+id/ic_home_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_list"
        app:layout_constraintEnd_toStartOf="@id/ic_list_list"
        app:layout_constraintStart_toEndOf="@id/ic_statistics_list"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_list" />

    <ImageView
        android:id="@+id/ic_list_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_list"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_list"
        app:layout_constraintEnd_toEndOf="@id/view_bottomBar_list"
        app:layout_constraintStart_toEndOf="@id/ic_home_list"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_list" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnListagemHistorico"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@color/blue"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_history"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/view_bottomBar_list"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnListagemAdd"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@color/blue"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/view_bottomBar_list"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>