<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Activity.HistoricoActivity">

    <View
        android:id="@+id/view_topBar_historico"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/blue"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewTitleHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Histórico de cancelados"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@id/view_topBar_historico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_topBar_historico" />

    <TextView
        android:id="@+id/btnLimparHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Limpar Tudo"
        android:textColor="@color/orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp" android:elevation="5dp" app:layout_constraintBottom_toBottomOf="@id/view_topBar_historico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_topBar_historico" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCancelados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/view_bottomBar_historico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_topBar_historico"
        tools:listitem="@layout/item_cancelado" />

    <View
        android:id="@+id/view_bottomBar_historico"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ic_statistics_historico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_statistics"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_historico"
        app:layout_constraintEnd_toStartOf="@id/ic_home_historico"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/view_bottomBar_historico"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_historico" />

    <ImageView
        android:id="@+id/ic_home_historico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_historico"
        app:layout_constraintEnd_toStartOf="@id/ic_list_historico"
        app:layout_constraintStart_toEndOf="@id/ic_statistics_historico"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_historico" />

    <ImageView
        android:id="@+id/ic_list_historico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_list"
        app:layout_constraintBottom_toBottomOf="@id/view_bottomBar_historico"
        app:layout_constraintEnd_toEndOf="@id/view_bottomBar_historico"
        app:layout_constraintStart_toEndOf="@id/ic_home_historico"
        app:layout_constraintTop_toTopOf="@id/view_bottomBar_historico" />

</androidx.constraintlayout.widget.ConstraintLayout>